# LogStay Mobile Environment Variables
# Copy this file to .env and replace placeholders with your actual Supabase project keys

# Supabase Cloud Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-jwt-payload.your-signature

# Optional App Metadata
EXPO_PUBLIC_APP_SCHEME=logstay
EXPO_PUBLIC_UNIVERSAL_LINK_BASE=https://logstay.app
